<?xml version="1.0" encoding="utf-8"?>
<!--
    Cadena de la tienda en un fichero aparte: strings.xml esta guardado en
    Windows-1252 y este fichero se escribe en UTF-8, que es lo que espera aapt2.
    Android fusiona todos los XML de una carpeta values-*, asi que no hay
    conflicto de claves.
-->
