<?xml version="1.0" encoding="utf-8"?>
<!--
  RetroCat adaptive launcher icon. The layers are the raster assets from
  AppAssets_2026-09-28 (Android/res), copied in as mipmap PNGs so the same artwork
  is used for both the adaptive (API 26+) and legacy (API 23-25) launchers.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/retrocat_launcher_background" />
    <foreground android:drawable="@mipmap/retrocat_launcher_foreground" />
    <!-- Themed icons (Android 13+). Same alpha silhouette as the foreground, tinted by the system. -->
    <monochrome android:drawable="@mipmap/retrocat_launcher_monochrome" />
</adaptive-icon>
